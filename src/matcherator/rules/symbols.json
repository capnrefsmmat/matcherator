{
  "Matcher": {
    "exclamation_marks": {
      "description": "Exclamation marks",
      "examples": [
        "I hate it!"
      ],
      "rules": [[
        {"IS_PUNCT": true, "ORTH": "!"}
      ]]
    },

    "question_marks": {
      "description": "Question marks",
      "examples": [
        "What do you think?"
      ],
      "rules": [[
        {"IS_PUNCT": true, "ORTH": "?"}
      ]]
    },

    "semicolons": {
      "description": "Semicolons",
      "examples": [
        "I like semicolons; they can be very useful."
      ],
      "rules": [[
        {"IS_PUNCT": true, "ORTH": ";"}
      ]]
    },

    "colons": {
      "description": "Colons",
      "examples": [
        "She proposed a radical solution: count all the colons."
      ],
      "rules": [[
        {"IS_PUNCT": true, "ORTH": ":"}
      ]]
    },

    "emoji": {
      "description": "Emoji",
      "examples": [
        "💩",
        "🧠 Cognitive Dissonance Pattern"
      ],
      "rules": [[
        {"_": {"is_emoji": true}}
      ]]
    },

    "em_dashes_unicode": {
      "description": "Em dashes (Unicode)",
      "examples": [
        "This isn't about technology—it's about trust.",
        "If we disagree on that, then yes — we’re speaking different languages."
      ],
      "rules": [[
        {"IS_PUNCT": true, "ORTH": "—"}
      ]]
    },

    "em_dashes_ascii": {
      "description": "Em dashes (ASCII)",
      "examples": [
        "This isn't about technology--it's about trust.",
        "This isn't about technology---it's about trust.",
        "If we disagree on that, then yes -- we’re speaking different languages."
      ],
      "rules": [
        [
          {"IS_PUNCT": true, "ORTH": "--"}
        ],
        [
          {"IS_PUNCT": true, "ORTH": "---"}
        ]
      ]
    },

    "cardinal_number": {
      "description": "Cardinal numbers",
      "examples": [
        "I have three cats.",
        "The cats live in unit 311."
      ],
      "counterexamples": [
        "One must do one's best."
      ],
      "rules": [[
        {"TAG": "CD"}
      ]]
    },

    "url": {
      "description": "URLs",
      "examples": [
        "You can find my website at www.example.com",
        "I got it from https://www.example.com."
      ],
      "rules": [[
        {"LIKE_URL": true}
      ]]
    },

    "email": {
      "description": "Email addresses",
      "examples": [
        "Send me a message at example@example.com.",
        "I got this weird message from weird@example.com and I don't know what it means."
      ],
      "rules": [[
        {"LIKE_EMAIL": true}
      ]]
    }
  },

  "DependencyMatcher": {},

  "PhraseMatcher": {},

  "Derived": {}
}
